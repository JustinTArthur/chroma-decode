@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/chromadec-targets.cmake" OPTIONAL)

if(NOT TARGET chromadec::chromadec)
    include(CMakeFindDependencyMacro)
    find_dependency(PkgConfig)
    pkg_check_modules(_chromadec REQUIRED IMPORTED_TARGET chromadec=@VERSION@)
    add_library(chromadec::chromadec ALIAS PkgConfig::_chromadec)
endif()

# Meson's package-init expansion defines set_and_check but not
# check_required_components (unlike CMake's native generator). Guard the call so
# the config works under both; chromadec exports no components to check anyway.
if(COMMAND check_required_components)
    check_required_components(chromadec)
endif()
