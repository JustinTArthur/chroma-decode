@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/chromadec-targets.cmake" OPTIONAL)

if(NOT TARGET chromadec::chromadec)
    include(CMakeFindDependencyMacro)
    find_dependency(PkgConfig)
    pkg_check_modules(_chromadec REQUIRED IMPORTED_TARGET chromadec=@VERSION@)
    add_library(chromadec::chromadec ALIAS PkgConfig::_chromadec)
endif()

check_required_components(chromadec)
