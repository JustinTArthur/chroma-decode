option('with_onnxruntime',
       type: 'boolean', value: true,
       description: 'Enable the ONNX Runtime inference backend (NN decoders via ORT)')

option('with_cuda',
       type: 'feature', value: 'auto',
       description: 'Build CUDA cuFFT pipeline for nnTransform3D (CUDA + TensorRT EPs)')

option('with_rocm',
       type: 'feature', value: 'auto',
       description: 'Build HIP/hipFFT pipeline for nnTransform3D (ROCm + MIGraphX EPs)')

option('with_coreml',
       type: 'feature', value: 'auto',
       description: 'Build native CoreML inference pipeline (macOS only; MLModel + MPSGraph FFT for nnTransform3D and ldzeug2)')

option('with_tests',
       type: 'boolean', value: true,
       description: 'Build the test suite')

option('with_examples',
       type: 'boolean', value: true,
       description: 'Build the plain-C example programs')

option('with_debug_overlay',
       type: 'boolean', value: false,
       description: 'Compile the framecanvas debug overlay')

option('onnxruntime_root',
       type: 'string', value: '',
       description: 'Manual ONNX Runtime install prefix (used as a fallback when pkg-config and system probes both fail)')

option('rocm_root',
       type: 'string', value: '',
       description: 'ROCm install prefix used as CMAKE_PREFIX_PATH for the hipfft + hip dependency lookups. Empty (default) relies on the default CMake search path, which works on distros that install ROCm into /usr (Gentoo). Set to /opt/rocm on Ubuntu/RHEL/SLES with AMD\'s apt/dnf packaging.')
